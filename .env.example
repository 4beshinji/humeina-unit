# VoiSona Talk (Windows VM)
VOISONA_URL=http://192.168.1.173:32766
VOISONA_USERNAME=your-email@example.com
VOISONA_PASSWORD=your-password

# VOICEVOX (Docker)
VOICEVOX_URL=http://localhost:50021

# LLM（llama.cppを標準使用。OLLAMA_URLは旧設定からのrollback時だけ使用）
# OLLAMA_URL=http://localhost:11434
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=Qwen3.8-27B
LLAMA_MODEL_PATH=/absolute/path/Qwen3.8-27B-IQ4_XS.gguf
# OpenCode Goはopt-in。秘密値をYAMLへ書かないでください。
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=qwen3.8-flash
# ROCmでは必須。RX 6900 XTがGPU 0、Raphael iGPUがGPU 1の構成例です。
YOMIAGE_LLM_GPU_DEVICE=0

# Slack (オプション)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
