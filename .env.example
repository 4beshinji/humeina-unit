# ユーザー設定ディレクトリの .env にコピーするか YOMIAGE_ENV_FILE で明示する。
# VoiSona Talk (Windows VM)
VOISONA_URL=http://192.168.1.173:32766
VOISONA_USERNAME=your-email@example.com
VOISONA_PASSWORD=your-password

# VOICEVOX (Docker)
VOICEVOX_URL=http://localhost:50021

# LLM（llama.cppを標準使用。OLLAMA_URLは旧設定からのrollback時だけ使用）
# OLLAMA_URL=http://localhost:11434
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=Qwen3.8-27B
LLAMA_MODEL_PATH=/absolute/path/Qwen3.8-27B-IQ4_XS.gguf
# OpenCode Goはopt-in。秘密値をYAMLへ書かないでください。
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=qwen3.8-flash
# ROCmでは必須。RX 6900 XTがGPU 0、Raphael iGPUがGPU 1の構成例です。
YOMIAGE_LLM_GPU_DEVICE=0

# Slack (オプション)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# 配置に依存しない保存先（未指定なら XDG_CONFIG_HOME / XDG_DATA_HOME を使用）
# YOMIAGE_USER_CONFIG_DIR=/absolute/path/to/user-config
# YOMIAGE_DATA_DIR=/absolute/path/to/runtime-data
# YOMIAGE_OUTPUT_DIR=/absolute/path/to/output
# YOMIAGE_ASSETS_DIR=/absolute/path/to/assets
# VOISONA_SHARED_DIR=/absolute/path/to/persistent-share
# VOISONA_VM_MOUNT=Z:
# VOICEPEAK_PATH=/absolute/path/to/voicepeak
# EX_VOICE_WAV_DIR=/absolute/path/to/ex-voice-clips
